{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "The app's name in Finder, the Dock and Spotlight. Info.plist's own CFBundleDisplayName is the bundle's file name (WallpaperMage), which macOS requires before it shows this name. “Wallpaper Mage” is the same in every language.",
