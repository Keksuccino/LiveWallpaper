    "NSAudioCaptureUsageDescription" : {
      "comment" : "macOS permission prompt for recording system audio, which scenes use to react to music. “Wallpaper Mage” is the app's name: keep it unchanged in every language.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage uses system audio so scene wallpapers can react to the music you play."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage verwendet das Systemaudio, damit Szenen-Hintergrundbilder auf die Musik reagieren können, die du abspielst."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mageはシステムオーディオを使って、シーン壁紙を再生中の音楽に反応させるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage는 씬 배경화면이 재생 중인 음악에 반응할 수 있도록 시스템 오디오를 사용해."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage 使用系统音频，让场景墙纸能够随你播放的音乐做出反应。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage korzysta z dźwięku systemowego, aby sceny mogły reagować na muzykę, której słuchasz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage использует системный звук, чтобы обои-сцены могли реагировать на музыку, которую ты включаешь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage використовує системний звук, щоб сцени могли реагувати на музику, яку ти вмикаєш."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage usa el audio del sistema para que los fondos de escena puedan reaccionar a la música que reproduces."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage usa el audio del sistema para que los fondos de escena reaccionen a la música que reproduces."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Wallpaper Mage usa o áudio do sistema para que os papéis de parede de cena possam reagir à música que você está ouvindo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage, sahne duvar kâğıtlarının çaldığın müziğe tepki verebilmesi için sistem sesini kullanır."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Wallpaper Mage χρησιμοποιεί τον ήχο του συστήματος, ώστε οι ταπετσαρίες σκηνών να αντιδρούν στη μουσική που παίζεις."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage utilise l’audio du système pour que les scènes puissent réagir à la musique que tu écoutes."
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "comment" : "macOS permission prompt when a wallpaper video is in the Desktop folder. “Wallpaper Mage” is the app's name: keep it unchanged in every language.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage needs access to play the videos you chose."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage braucht Zugriff, um die Videos abzuspielen, die du ausgewählt hast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだビデオを再生するには、Wallpaper Mageにアクセスを許可してね。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 비디오를 재생하려면 Wallpaper Mage에 접근 권한이 필요해."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage 需要访问权限才能播放你选择的视频。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage potrzebuje dostępu, aby odtwarzać wybrane przez ciebie filmy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage нужен доступ, чтобы воспроизводить выбранные тобой видео."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програмі Wallpaper Mage потрібен доступ, щоб відтворювати вибрані тобою відео."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage necesita acceso para reproducir los vídeos que has elegido."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage necesita acceso para reproducir los videos que elegiste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Wallpaper Mage precisa de acesso para reproduzir os vídeos que você escolheu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage’in seçtiğin videoları oynatabilmesi için erişim izni gerekir."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Wallpaper Mage χρειάζεται πρόσβαση για να αναπαράγει τα βίντεο που επέλεξες."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Mage a besoin d’un accès pour lire les vidéos que tu as choisies."
          }
        }
      }
    },
