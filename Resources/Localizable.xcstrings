          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αρχείο κατέβηκε, αλλά δεν ήταν δυνατή η αποθήκευσή του στη βιβλιοθήκη σου. (%@)"
