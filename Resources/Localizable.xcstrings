    "Put every setting of this wallpaper and this display’s energy settings back to their defaults." : {
      "comment" : "Tooltip of the Reset button in a display's wallpaper settings: it also resets the display's Energy section.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt alle Einstellungen dieses Hintergrundbilds und die Energieeinstellungen dieses Displays auf die Standardwerte zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρει όλες τις ρυθμίσεις αυτής της ταπετσαρίας και τις ρυθμίσεις ενέργειας αυτής της οθόνης στις προεπιλογές τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece todos los ajustes de este fondo de pantalla y los ajustes de energía de esta pantalla a sus valores por omisión."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece toda la configuración de este fondo y la configuración de energía de esta pantalla a sus valores predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablit les valeurs par défaut de tous les réglages de ce fond d’écran et des réglages d’énergie de cet écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この壁紙のすべての設定と、このディスプレイのエネルギー設定をデフォルトに戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 배경화면의 모든 설정과 이 디스플레이의 에너지 설정을 기본값으로 되돌립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywróć wszystkie ustawienia tej tapety i ustawienia energii tego monitora do wartości domyślnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura todos os ajustes deste papel de parede e os ajustes de energia desta tela para o padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернуть все настройки этих обоев и настройки энергии этого дисплея к значениям по умолчанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu duvar kâğıdının tüm ayarlarını ve bu ekranın enerji ayarlarını varsayılan değerlerine döndürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відновити типові значення всіх параметрів цієї шпалери та параметрів енергії цього дисплея."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此墙纸的所有设置和此显示器的能耗设置恢复为默认值。"
          }
        }
      }
    },
