    "No code or approval arrived in time. Start again." : {
      "comment" : "Error message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weder Code noch Bestätigung sind rechtzeitig angekommen. Fang noch mal von vorn an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
