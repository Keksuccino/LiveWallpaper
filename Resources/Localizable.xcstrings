    "A Steam download is running. Wait for it to finish, then try again." : {
      "comment" : "Error message of the shared files card.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Steam-Download läuft. Warte, bis er abgeschlossen ist, und versuche es dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρίσκεται σε εξέλιξη μια λήψη του Steam. Περιμένετε να ολοκληρωθεί και δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una descarga de Steam en curso. Espera a que termine e inténtalo de nuevo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una descarga de Steam en curso. Espera a que termine e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un téléchargement Steam est en cours. Attendez qu’il se termine, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steamのダウンロードが実行中です。完了するまで待ってから、もう一度やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 다운로드가 진행 중입니다. 완료될 때까지 기다린 후 다시 시도하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa pobieranie ze Steam. Poczekaj, aż się zakończy, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um download da Steam está em andamento. Aguarde a conclusão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идет загрузка из Steam. Дождитесь ее завершения и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Steam indirmesi sürüyor. Bitmesini bekleyip yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триває викачування зі Steam. Зачекайте, доки воно завершиться, і спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在进行下载。请等待其完成后再试一次。"
          }
        }
      }
    },
