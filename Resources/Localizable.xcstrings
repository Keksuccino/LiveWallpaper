    "Enter your birthdate to see them. You only need to do this once." : {
      "comment" : "Message of the birthdate dialog in front of NSFW wallpapers.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib dein Geburtsdatum ein, um sie zu sehen. Das musst du nur einmal machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε την ημερομηνία γέννησής σου για να τις δεις. Χρειάζεται μόνο μία φορά."
          }
        },
        "es" : {
          "stringUnit" : {
