    "Paste a Workshop link or item number above. Video and scene wallpapers can play." : {
      "comment" : "Text of the Workshop page before anything was looked up.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze oben einen Workshop-Link oder eine Objektnummer ein. Video- und Szenen-Hintergrundbilder können abgespielt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επικόλλησε παραπάνω έναν σύνδεσμο ή αριθμό αντικειμένου του Workshop. Μπορούν να αναπαραχθούν ταπετσαρίες βίντεο και σκηνών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
