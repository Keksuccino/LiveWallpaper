        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź klucz w Ustawieniach Steam albo usuń go i zamiast tego wklej link do Warsztatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a chave nos Ajustes da Steam ou remova-a e cole um link da Oficina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверь ключ в настройках Steam или удали его и вставь ссылку из Мастерской."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Ayarları’ndaki anahtarı denetle ya da anahtarı kaldırıp onun yerine bir Atölye bağlantısı yapıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевір ключ у Параметрах Steam або вилучи його й натомість встав посилання з Майстерні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查一下 Steam 设置中的密钥，或者把它移除，改为粘贴创意工坊链接。"
          }
        }
      }
    },
    "Check the password and try again. After several wrong tries Steam makes you wait." : {
      "comment" : "Error message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe das Passwort und versuche es erneut. Nach mehreren Fehlversuchen lässt Steam dich warten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έλεγξε το συνθηματικό και δοκίμασε ξανά. Μετά από αρκετές λάθος προσπάθειες, το Steam σε βάζει να περιμένεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la contraseña e inténtalo de nuevo. Tras varios intentos fallidos, Steam te hace esperar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la contraseña e inténtalo de nuevo. Después de varios intentos fallidos, Steam te hace esperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie le mot de passe et réessaie. Après plusieurs mauvais essais, Steam te fait patienter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードを確認して、もう一度試してみて。何度も間違えると、Steamにしばらく待たされるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호를 확인하고 다시 시도해 줘. 여러 번 틀리면 Steam이 잠시 기다리게 해."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź hasło i spróbuj ponownie. Po kilku błędnych próbach Steam każe odczekać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a senha e tente novamente. Após várias tentativas erradas, a Steam faz você esperar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверь пароль и попробуй снова. После нескольких неудачных попыток Steam попросит подождать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolayı denetleyip yeniden dene. Birkaç hatalı denemeden sonra Steam seni bekletir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевір пароль і спробуй ще раз. Після кількох невдалих спроб Steam змушує зачекати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查一下密码，然后再试一次。输错太多次的话，Steam 会让你等一段时间。"
          }
        }
      }
    },
