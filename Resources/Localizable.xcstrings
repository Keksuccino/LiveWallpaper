    "Too many sign-in attempts. Wait about 30 minutes before trying again." : {
      "comment" : "Error message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anmeldeversuche. Warte etwa 30 Minuten, bevor du es erneut versuchst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάρα πολλές προσπάθειες σύνδεσης. Περιμένετε περίπου 30 λεπτά πριν δοκιμάσετε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
