    "Check the key in Steam Settings, or remove it and paste a Workshop link instead." : {
      "comment" : "Error message about the Steam Web API key.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe den Schlüssel in den Steam-Einstellungen oder entferne ihn und setze stattdessen einen Workshop-Link ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
