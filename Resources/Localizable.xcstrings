          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives de connexion. Attendez environ 30 minutes avant de réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインの試行回数が多すぎます。約30分待ってから、もう一度やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 시도 횟수가 너무 많습니다. 약 30분 후에 다시 시도하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
