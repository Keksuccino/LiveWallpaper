    "Check the key in Steam Settings, or remove it and paste a Workshop link instead." : {
      "comment" : "Error message about the Steam Web API key.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe den Schlüssel in den Steam-Einstellungen oder entferne ihn und setze stattdessen einen Workshop-Link ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε το κλειδί στις Ρυθμίσεις Steam ή αφαιρέστε το και επικολλήστε αντ’ αυτού έναν σύνδεσμο του Workshop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la clave en Ajustes de Steam, o elimínala y pega un enlace del Workshop en su lugar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la clave en Configuración de Steam, o quítala y pega un enlace del Workshop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez la clé dans les réglages Steam, ou supprimez-la et collez plutôt un lien du Workshop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam設定でキーを確認するか、キーを削除して代わりにワークショップのリンクをペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 설정에서 키를 확인하거나, 키를 제거하고 대신 창작마당 링크를 붙여넣으십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź klucz w Ustawieniach Steam albo usuń go i zamiast tego wklej link do Warsztatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a chave nos Ajustes da Steam ou remova-a e cole um link da Oficina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте ключ в настройках Steam или удалите его и вставьте ссылку на Мастерскую."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Ayarları’ndaki anahtarı denetleyin veya anahtarı kaldırıp bunun yerine bir Atölye bağlantısı yapıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте ключ у Параметрах Steam або вилучіть його й натомість вставте посилання з Майстерні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 Steam 设置中检查密钥，或将其移除并改为粘贴创意工坊链接。"
          }
        }
      }
    },
    "Check the password and try again. After several wrong tries Steam makes you wait." : {
      "comment" : "Error message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe das Passwort und versuche es erneut. Nach mehreren Fehlversuchen lässt Steam dich warten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε το συνθηματικό και δοκιμάστε ξανά. Μετά από αρκετές λανθασμένες προσπάθειες, το Steam επιβάλλει αναμονή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la contraseña e inténtalo de nuevo. Tras varios intentos fallidos, Steam te hace esperar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la contraseña e inténtalo de nuevo. Después de varios intentos fallidos, Steam te hace esperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez le mot de passe et réessayez. Après plusieurs tentatives erronées, Steam vous fait patienter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードを確認して、もう一度やり直してください。何度も間違えると、しばらく待つようSteamから求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호를 확인하고 다시 시도하십시오. 여러 번 잘못 입력하면 Steam에서 잠시 기다려야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź hasło i spróbuj ponownie. Po kilku błędnych próbach Steam każe odczekać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a senha e tente novamente. Após várias tentativas erradas, a Steam faz você esperar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте пароль и повторите попытку. После нескольких неудачных попыток Steam попросит подождать."
          }
        },
        "tr" : {
          "stringUnit" : {
