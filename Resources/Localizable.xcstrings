    "Installing it means accepting Apple’s Rosetta software license." : {
      "comment" : "Shown in the Rosetta step.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Installation akzeptierst du Apples Softwarelizenz für Rosetta."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με την εγκατάσταση αποδέχεστε την άδεια χρήσης λογισμικού Rosetta της Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalarlo implica aceptar la licencia de software de Rosetta de Apple."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al instalarlo, aceptas la licencia de software de Rosetta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installer implique d’accepter la licence du logiciel Rosetta d’Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールすると、AppleのRosettaソフトウェア使用許諾契約に同意したことになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치하면 Apple의 Rosetta 소프트웨어 사용권 계약에 동의하게 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalacja oznacza akceptację umowy licencyjnej oprogramowania Rosetta firmy Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalá-lo significa aceitar a licença de software do Rosetta da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установив ее, вы принимаете лицензионное соглашение Apple на ПО Rosetta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklemek, Apple’ın Rosetta yazılım lisansını kabul etmek anlamına gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інсталювавши Rosetta, ви приймаєте умови ліцензії Apple на програмне забезпечення Rosetta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装即表示接受 Apple 的 Rosetta 软件许可协议。"
          }
        }
      }
    },
    "Installing… this can take a few minutes. Your Mac may ask for your password." : {
      "comment" : "Shown while Rosetta installs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird installiert … Das kann einige Minuten dauern. Dein Mac fragt eventuell nach deinem Passwort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγκατάσταση… μπορεί να διαρκέσει μερικά λεπτά. Το Mac σας ενδέχεται να ζητήσει το συνθηματικό σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
