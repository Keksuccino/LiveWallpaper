    "Browsing needs a free Steam Web API key. Add one in Steam Settings, or paste a link above." : {
      "comment" : "Hint on the Workshop page. “Steam Web API key” is Valve's term.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Durchsuchen brauchst du einen kostenlosen Steam-Web-API-Schlüssel. Füge ihn in den Steam-Einstellungen hinzu oder setze oben einen Link ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για την περιήγηση χρειάζεται ένα δωρεάν κλειδί Steam Web API. Προσθέστε ένα στις Ρυθμίσεις Steam ή επικολλήστε έναν σύνδεσμο παραπάνω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para explorar se necesita una clave de API web de Steam gratuita. Añade una en Ajustes de Steam o pega un enlace arriba."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para explorar necesitas una clave de API web de Steam gratuita. Agrégala en Configuración de Steam o pega un enlace arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navigation nécessite une clé d’API Web Steam gratuite. Ajoutez-en une dans les réglages Steam ou collez un lien ci-dessus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウズするには無料のSteam Web APIキーが必要です。Steam設定で追加するか、上にリンクをペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘러보려면 무료 Steam Web API 키가 필요합니다. Steam 설정에서 키를 추가하거나 위에 링크를 붙여넣으십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądanie wymaga bezpłatnego klucza Steam Web API. Dodaj go w Ustawieniach Steam lub wklej link powyżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para explorar, é preciso uma chave gratuita da Steam Web API. Adicione uma nos Ajustes da Steam ou cole um link acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для просмотра нужен бесплатный ключ Steam Web API. Добавьте его в настройках Steam или вставьте ссылку выше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göz atmak için ücretsiz bir Steam Web API anahtarı gerekir. Steam Ayarları’ndan bir anahtar ekleyin veya yukarıya bir bağlantı yapıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
