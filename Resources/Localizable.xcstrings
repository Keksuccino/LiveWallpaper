          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête le fond d’écran animé sur cet écran et rétablit le fond d’écran par défaut de macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このディスプレイのライブ壁紙を止めて、macOSのデフォルトの壁紙に戻す。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디스플레이의 라이브 배경화면을 멈추고 macOS 기본 배경화면으로 되돌려."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymaj animowaną tapetę na tym monitorze i wróć do domyślnej tapety macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompe o papel de parede animado nesta tela e volta ao papel de parede padrão do macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановить живые обои на этом дисплее и вернуть стандартные обои macOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ekrandaki canlı duvar kâğıdını durdurur ve varsayılan macOS duvar kâğıdına döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупинити живу шпалеру на цьому дисплеї й повернутися до типової шпалери macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止此显示器上的动态墙纸，并恢复为 macOS 默认墙纸。"
          }
        }
      }
    },
