    "Steam’s tool updates itself the first time it runs. This can take a few minutes." : {
      "comment" : "Shown during setup step 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Steam-Tool aktualisiert sich beim ersten Start selbst. Das kann einige Minuten dauern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το εργαλείο του Steam ενημερώνεται αυτόματα την πρώτη φορά που εκτελείται. Αυτό μπορεί να διαρκέσει μερικά λεπτά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta de Steam se actualiza la primera vez que se ejecuta. Esto puede tardar unos minutos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta de Steam se actualiza la primera vez que se ejecuta. Esto puede tardar unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil de Steam se met à jour lors de sa première exécution. Cela peut prendre quelques minutes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steamのツールは初回実行時に自動でアップデートされます。数分かかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 도구는 처음 실행될 때 자체적으로 업데이트됩니다. 몇 분 정도 걸릴 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzędzie Steam aktualizuje się przy pierwszym uruchomieniu. Może to potrwać kilka minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
