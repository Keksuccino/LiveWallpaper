    "SteamCMD is an Intel program. On Apple silicon install Rosetta once: softwareupdate --install-rosetta --agree-to-license" : {
      "comment" : "Error message. The end is a Terminal command: keep it exactly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD ist ein Intel-Programm. Installiere auf einem Mac mit Apple Chip einmalig Rosetta: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το SteamCMD είναι πρόγραμμα για Intel. Σε Mac με Apple silicon, εγκατάστησε μία φορά το Rosetta: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD es un programa para Intel. En un Mac con chip de Apple, instala Rosetta una vez: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD es un programa para Intel. En una Mac con chip de Apple, instala Rosetta una vez: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD est un programme Intel. Sur un Mac avec puce Apple, installe Rosetta une fois : softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMDはIntel用のプログラムなんだ。Appleシリコン搭載のMacでは、Rosettaを一度インストールしてね：softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD는 Intel 프로그램이야. Apple 실리콘에서는 Rosetta를 한 번 설치해 줘: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD to program dla procesorów Intel. Na Macu z układem Apple zainstaluj jednorazowo Rosettę: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SteamCMD é um programa para Intel. Em Macs com Apple silicon, instale o Rosetta uma única vez: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD — программа для Intel. На Mac с чипом Apple один раз установи Rosetta: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD bir Intel programı. Apple çipli Mac’lerde Rosetta’yı bir kez yükle: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD — програма для процесорів Intel. На Mac з Apple silicon один раз інсталюй Rosetta: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 是 Intel 程序。在搭载 Apple 芯片的 Mac 上，需要先安装一次 Rosetta：softwareupdate --install-rosetta --agree-to-license"
          }
        }
      }
    },
    "SteamCMD isn’t installed" : {
      "comment" : "Error title. SteamCMD is Valve's download tool.",
      "localizations" : {
        "de" : {
