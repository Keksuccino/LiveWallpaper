        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le son de tous les fonds d’écran, comme « Couper le son » dans la barre des menus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの「サウンドを消音」と同様に、すべての壁紙を消音します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대의 사운드 음소거와 마찬가지로 모든 배경화면을 음소거합니다."
