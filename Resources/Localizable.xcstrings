    "Steam wants a Steam Guard code. Enter the newest one you have." : {
      "comment" : "Steam Guard code prompt.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam verlangt einen Steam Guard-Code. Gib den neuesten ein, den du hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Steam ζητά κωδικό Steam Guard. Εισαγάγετε τον πιο πρόσφατο που έχετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam pide un código de Steam Guard. Introduce el más reciente que tengas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam pide un código de Steam Guard. Ingresa el más reciente que tengas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam demande un code Steam Guard. Saisissez le plus récent dont vous disposez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Guardコードが必要です。お手元の最新のコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam에서 Steam Guard 코드를 요청합니다. 가장 최근에 받은 코드를 입력하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
