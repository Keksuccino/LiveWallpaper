    "SteamCMD stopped responding. Try again; the first run after installing can take a few minutes." : {
      "comment" : "Error message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD reagiert nicht mehr. Versuche es erneut; der erste Start nach der Installation kann einige Minuten dauern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το SteamCMD σταμάτησε να αποκρίνεται. Δοκίμασε ξανά. Η πρώτη εκτέλεση μετά την εγκατάσταση μπορεί να διαρκέσει μερικά λεπτά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD ha dejado de responder. Inténtalo de nuevo; la primera ejecución tras la instalación puede tardar unos minutos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD dejó de responder. Inténtalo de nuevo; la primera ejecución después de instalarlo puede tardar unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD ne répond plus. Réessaie ; la première exécution après l’installation peut prendre quelques minutes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMDが応答しなくなった。もう一度試してみて。インストール後の初回実行は数分かかることもあるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD가 응답을 멈췄어. 다시 시도해 줘. 설치 후 처음 실행할 때는 몇 분 정도 걸릴 수 있어."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD przestał odpowiadać. Spróbuj ponownie; pierwsze uruchomienie po instalacji może potrwać kilka minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SteamCMD parou de responder. Tente novamente; a primeira execução após a instalação pode levar alguns minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD перестал отвечать. Попробуй снова: первый запуск после установки может занять несколько минут."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD yanıt vermiyor. Yeniden dene; yüklemeden sonraki ilk çalıştırma birkaç dakika sürebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD перестав відповідати. Спробуй ще раз: перший запуск після інсталювання може тривати кілька хвилин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteamCMD 停止响应了。再试一次；安装后首次运行可能需要几分钟。"
          }
        }
      }
    },
