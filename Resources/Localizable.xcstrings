    "Gives every other wallpaper in this playlist this wallpaper’s settings, apart from scene properties." : {
      "comment" : "Tooltip of “Apply to All Wallpapers” in the playlist editor's inspector.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überträgt die Einstellungen dieses Hintergrundbilds auf alle anderen Hintergrundbilder in dieser Playlist, außer den Szeneneigenschaften."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμόζει τις ρυθμίσεις αυτής της ταπετσαρίας σε όλες τις άλλες ταπετσαρίες αυτής της λίστας αναπαραγωγής, εκτός από τις ιδιότητες σκηνής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da a todos los demás fondos de esta lista de reproducción los ajustes de este fondo, salvo las propiedades de escena."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica a todos los demás fondos de esta playlist la configuración de este fondo, excepto las propiedades de escena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne à tous les autres fonds d’écran de cette liste de lecture les réglages de ce fond d’écran, sauf les propriétés de scène."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この壁紙の設定を、このプレイリストのほかの壁紙すべてに適用する（シーンのプロパティは除く）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "씬 속성을 제외한 이 배경화면의 설정을 이 재생목록의 다른 모든 배경화면에 적용해."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekazuje ustawienia tej tapety wszystkim pozostałym tapetom w tej playliście, z wyjątkiem właściwości sceny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica os ajustes deste papel de parede a todos os outros papéis de parede desta playlist, exceto as propriedades de cena."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передает всем остальным обоям в этом плейлисте настройки этих обоев, кроме свойств сцены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu duvar kâğıdının sahne özellikleri dışındaki ayarlarını bu oynatma listesindeki diğer tüm duvar kâğıtlarına uygular."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосовує параметри цієї шпалери, крім властивостей сцени, до всіх інших шпалер у цій підбірці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把这张墙纸的设置（场景属性除外）应用到这个播放列表里的其他所有墙纸。"
          }
        }
      }
    },
