          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega arriba un enlace del Workshop o un número de elemento. Se pueden reproducir fondos de video y de escena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colle un lien du Workshop ou un numéro d’élément ci-dessus. Les fonds d’écran vidéo et les scènes peuvent être lus."
