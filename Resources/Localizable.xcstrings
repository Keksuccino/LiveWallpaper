    "Select a wallpaper in the playlist to change how it looks and sounds there." : {
      "comment" : "Shown in the inspector of the playlist editor while no wallpaper of the playlist is selected.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Hintergrundbild der Playlist aus, um zu ändern, wie es dort aussieht und klingt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίλεξε μια ταπετσαρία της λίστας αναπαραγωγής για να αλλάξεις την εμφάνιση και τον ήχο της εκεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un fondo de la lista de reproducción para cambiar su aspecto y sonido en ella."
