          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль передається безпосередньо інструменту Valve і ніколи не зберігається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密码会直接发送给 Valve 的工具，且绝不会被存储。"
          }
        }
      }
    },
    "Your saved Steam login has expired. Sign in again." : {
