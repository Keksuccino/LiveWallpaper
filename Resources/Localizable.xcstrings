    "No live wallpaper. Click one in your library to use it here." : {
      "comment" : "Below the display's name on the Home page when it shows no live wallpaper.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Live-Hintergrundbild. Klicke auf eines in deiner Bibliothek, um es hier zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία ζωντανή ταπετσαρία. Κάντε κλικ σε μία στη βιβλιοθήκη σας για να τη χρησιμοποιήσετε εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin fondo animado. Haz clic en uno de tu biblioteca para usarlo aquí."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin fondo animado. Haz clic en uno de tu biblioteca para usarlo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun fond d’écran animé. Cliquez sur l’un d’eux dans votre bibliothèque pour l’utiliser ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ壁紙はありません。ライブラリで壁紙をクリックすると、ここで使用できます。"
