          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструмент Steam создан для Mac с процессором Intel. Установи Rosetta и попробуй снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam aracı Intel işlemcili Mac’ler için tasarlanmıştır. Rosetta’yı yükleyip yeniden dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
