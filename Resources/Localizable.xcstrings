    "Steam sent a prompt this app doesn’t know. Details are below; you can also sign in using Terminal." : {
      "comment" : "Error message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam hat eine Abfrage gesendet, die diese App nicht kennt. Details findest du unten; du kannst dich auch über das Terminal anmelden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Steam έστειλε ένα αίτημα που η εφαρμογή δεν αναγνωρίζει. Θα βρεις τις λεπτομέρειες παρακάτω. Μπορείς επίσης να συνδεθείς μέσω του Τερματικού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ha enviado una solicitud que esta app no conoce. Tienes los detalles abajo; también puedes iniciar sesión desde Terminal."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
