    "Installing it means accepting Apple’s Rosetta software license." : {
      "comment" : "Shown in the Rosetta step.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Installation akzeptierst du Apples Softwarelizenz für Rosetta."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με την εγκατάσταση αποδέχεσαι την άδεια χρήσης λογισμικού Rosetta της Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
