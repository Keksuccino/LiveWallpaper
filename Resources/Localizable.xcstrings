    "Silences every wallpaper, like Mute Sound in the menu bar." : {
      "comment" : "Explanation under the Mute all wallpapers switch.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet alle Hintergrundbilder stumm, wie „Ton stummschalten“ in der Menüleiste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θέτει σε σίγαση όλες τις ταπετσαρίες, όπως η «Σίγαση ήχου» στη γραμμή μενού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silencia todos los fondos de pantalla, como “Silenciar sonido” en la barra de menús."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silencia todos los fondos, como Silenciar sonido en la barra de menús."
          }
