          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструмент Steam обновляется при первом запуске. Это может занять несколько минут."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam aracı ilk çalıştığında kendini günceller. Bu birkaç dakika sürebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
