    "Share of the display’s pixels the scene is drawn at. Lower is lighter on the GPU." : {
      "comment" : "Tooltip of the scene's Resolution slider.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil der Display-Pixel, mit dem die Szene dargestellt wird. Niedrigere Werte entlasten die GPU."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ποσοστό των pixel της οθόνης στο οποίο αποδίδεται η σκηνή. Χαμηλότερη τιμή σημαίνει μικρότερο φόρτο για την GPU."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porcentaje de los píxeles de la pantalla con el que se dibuja la escena. Un valor más bajo exige menos a la GPU."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proporción de los píxeles de la pantalla con la que se dibuja la escena. Un valor más bajo exige menos a la GPU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part des pixels de l’écran utilisée pour le rendu de la scène. Une valeur plus basse sollicite moins le GPU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイのピクセル数に対して、シーンをどれくらいの割合で描画するか。低くするとGPUの負荷が軽くなるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "씬을 그릴 때 쓰는 디스플레이 픽셀의 비율이야. 낮을수록 GPU 부담이 줄어."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Część pikseli monitora używana do renderowania sceny. Niższa wartość mniej obciąża GPU."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proporção dos pixels da tela usada para renderizar a cena. Valores menores exigem menos da GPU."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какая доля пикселей дисплея используется для отрисовки сцены. Чем меньше, тем ниже нагрузка на GPU."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahnenin ekran piksellerinin ne kadarıyla çizileceği. Düşük değer GPU’yu daha az yorar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частка пікселів дисплея, з якою відображається сцена. Що нижче значення, то менше навантаження на графічний процесор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绘制场景时使用的显示器像素比例。数值越低，GPU 负担越轻。"
          }
        }
      }
    },
