        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정을 모든 배경화면에 적용하겠습니까?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastosować te ustawienia do wszystkich tapet?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar estes ajustes a todos os papéis de parede?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применить эти настройки ко всем обоям?"
