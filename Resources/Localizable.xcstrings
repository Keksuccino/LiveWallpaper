          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αντικείμενο ανήκει στο Workshop άλλου παιχνιδιού. Εδώ λειτουργούν μόνο ταπετσαρίες του Wallpaper Engine."
          }
