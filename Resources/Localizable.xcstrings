    "Lets audio visualisers in scene wallpapers follow what your Mac plays." : {
      "comment" : "Explanation under the Wallpapers react to system audio switch.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt Audio-Visualisierungen in Szenen-Hintergrundbildern auf das reagieren, was dein Mac abspielt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει στους οπτικοποιητές ήχου στις ταπετσαρίες σκηνών να ακολουθούν ό,τι παίζει το Mac σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que los visualizadores de audio de los fondos de escena sigan lo que reproduce tu Mac."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que los visualizadores de audio de los fondos de escena sigan lo que reproduce tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet aux visualiseurs audio des scènes de suivre ce que lit ton Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーン壁紙のオーディオビジュアライザが、Macで再生中のサウンドに反応するよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "씬 배경화면의 오디오 시각화 효과가 Mac에서 재생 중인 소리에 맞춰 반응해."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala wizualizacjom dźwięku w scenach reagować na to, co odtwarza twój Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que os visualizadores de áudio dos papéis de parede de cena acompanhem o que o Mac reproduz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудиовизуализаторы в обоях-сценах реагируют на звук, который играет на твоем Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahne duvar kâğıtlarındaki ses görselleştiricilerin Mac’inde çalan sese tepki vermesini sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
