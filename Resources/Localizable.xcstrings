    "System Default follows the order of your languages in System Settings > General > Language & Region." : {
      "comment" : "Explanation under the app language setting. “System Default” is the option of that name; use macOS's own names for System Settings > General > Language & Region.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Systemstandard“ folgt der Reihenfolge deiner Sprachen in „Systemeinstellungen“ > „Allgemein“ > „Sprache & Region“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Προεπιλογή συστήματος» ακολουθεί τη σειρά των γλωσσών σου στις Ρυθμίσεις συστήματος > Γενικά > Γλώσσα και περιοχή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Predeterminado del sistema” sigue el orden de tus idiomas en Ajustes del Sistema > General > Idioma y región."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predeterminado del sistema sigue el orden de tus idiomas en Configuración del Sistema > General > Idioma y región."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Langue du système » suit l’ordre de tes langues dans Réglages Système > Général > Langue et région."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システムのデフォルト」では、「システム設定」>「一般」>「言語と地域」の言語の順番に従うよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 기본값은 시스템 설정 > 일반 > 언어 및 지역에 있는 언어 순서를 따라."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Język systemu” trzyma się kolejności twoich języków w Ustawieniach systemowych > Ogólne > Język i region."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção Padrão do sistema segue a ordem dos seus idiomas em Ajustes do Sistema > Geral > Idioma e Região."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Язык системы» берет порядок твоих языков из раздела «Системные настройки» > «Основные» > «Язык и регион»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem varsayılanı, Sistem Ayarları > Genel > Dil ve Bölge’deki dil sıranı izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Мова системи» відповідає порядку твоїх мов у «Системних параметрах» > «Загальні» > «Мова й регіон»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
