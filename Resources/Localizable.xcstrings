    "Open the Steam Mobile app and approve the sign-in. This window continues by itself." : {
      "comment" : "Shown while Steam waits for approval in the Steam Mobile app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Steam-Mobile-App und bestätige die Anmeldung. Danach geht’s hier von selbst weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άνοιξε την εφαρμογή Steam Mobile και έγκρινε τη σύνδεση. Αυτό το παράθυρο θα συνεχίσει μόνο του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la app Steam Mobile y aprueba el inicio de sesión. Esta ventana continuará automáticamente."
