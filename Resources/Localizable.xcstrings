          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suaviza bordas serrilhadas. Consome um pouco de tempo da GPU."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сглаживает зубчатые края. Немного нагружает GPU."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pürüzlü kenarları yumuşatır. Biraz GPU süresi harcar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
