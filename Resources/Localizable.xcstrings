        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un fondo de la playlist para cambiar cómo se ve y suena en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionne un fond d’écran de la liste de lecture pour y modifier son apparence et son audio."
          }
