    "One wallpaper downloading · the rest of the app stays free to use." : {
      "comment" : "Subtitle of the Downloads page while one download runs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Hintergrundbild wird heruntergeladen · du kannst die App weiter nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λήψη μίας ταπετσαρίας · μπορείτε να χρησιμοποιείτε κανονικά την υπόλοιπη εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargando un fondo de pantalla · puedes seguir usando el resto de la app."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargando un fondo · puedes seguir usando el resto de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fond d’écran en cours de téléchargement · vous pouvez continuer à utiliser l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1個の壁紙をダウンロード中 · その間もアプリのほかの機能は自由に使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면 1개 다운로드 중 · 그동안 앱의 다른 기능을 자유롭게 사용할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieranie jednej tapety · możesz dalej korzystać z reszty aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um papel de parede sendo baixado · o resto do app continua disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружаются одни обои · приложением можно пользоваться как обычно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
