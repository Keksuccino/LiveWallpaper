    "Change the playlist’s wallpapers, their order and settings, its timing and its transition." : {
      "comment" : "Tooltip of “Edit Playlist…” in the Home inspector.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere die Hintergrundbilder der Playlist, ihre Reihenfolge und Einstellungen, die Anzeigedauer und den Übergang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλάξτε τις ταπετσαρίες της λίστας αναπαραγωγής, τη σειρά και τις ρυθμίσεις τους, τη διάρκεια και τη μετάβαση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia los fondos de la lista de reproducción, su orden y ajustes, la duración y la transición."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia los fondos de la playlist, su orden y configuración, la duración y la transición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez les fonds d’écran de la liste de lecture, leur ordre et leurs réglages, la durée d’affichage et la transition."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリストの壁紙、その順序と設定、表示時間、トランジションを変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생목록의 배경화면, 순서와 설정, 표시 시간 및 전환 효과를 변경합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień tapety playlisty, ich kolejność i ustawienia, czas wyświetlania oraz przejście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altere os papéis de parede da playlist, sua ordem e ajustes, o tempo de exibição e a transição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измените обои плейлиста, их порядок и настройки, время показа и переход."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatma listesinin duvar kâğıtlarını, sıralarını ve ayarlarını, gösterim süresini ve geçişini değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть шпалери підбірки, їхній порядок і параметри, тривалість показу та перехід."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改播放列表的墙纸、其顺序和设置、显示时长以及过渡效果。"
          }
        }
      }
    },
